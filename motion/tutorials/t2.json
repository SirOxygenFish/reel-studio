{
 "_about": "Tutorial 2 (iPhone, 9:16), one tap per step. Each step: part (badge), screen (a drawing in kit.js), shot (a real render of the upload page from shots.mjs), taps (what the finger presses, in order; the last one 0.75 s before the next step), ring (a highlight without a tap), cap ($key in strings.json), d (seconds). scripts/tutorials.py turns the steps into scenes joined by short plain fades, with a still camera so text stays sharp.",
 "size": [1080, 1920], "out": "upload-page/tutorials/tutorial2-iphone.{lang}.mp4", "max_len": 60, "ship_crf": 22, "shots": true,
 "title": {"d": 2.5, "title": "$title", "sub": "$sub", "shot": "install"},
 "steps": [
  {"part": 1, "screen": "page", "shot": "install", "taps": ["install"], "cap": "$s_install", "d": 2.8},
  {"part": 1, "screen": "file", "taps": ["open"], "cap": "$s_open", "d": 2.8},
  {"part": 1, "screen": "import", "taps": ["add"], "cap": "$s_add", "d": 2.8},
  {"part": 1, "screen": "editor", "taps": ["done"], "cap": "$s_done", "d": 2.6},
  {"part": 1, "screen": "page", "shot": "install", "taps": ["added"], "cap": "$s_added", "d": 2.7},
  {"part": 2, "screen": "page", "shot": "page", "taps": ["share"], "cap": "$s_share", "d": 2.5},
  {"part": 2, "screen": "share", "shot": "page", "taps": ["a2hs"], "cap": "$s_a2hs", "d": 2.6},
  {"part": 2, "screen": "a2hs", "taps": ["add"], "cap": "$s_a2hsAdd", "d": 2.5},
  {"part": 3, "screen": "home", "taps": ["reel"], "cap": "$s_icon", "d": 2.6},
  {"part": 3, "screen": "page", "shot": "page", "taps": ["choose"], "cap": "$s_choose", "d": 2.6},
  {"part": 3, "screen": "picker", "taps": ["th1", "th3"], "sel": ["th1", "th3"], "cap": "$s_pick", "d": 3.2},
  {"part": 3, "screen": "picker", "picked": true, "selected": ["th1", "th3"], "taps": ["add"], "cap": "$s_pickAdd", "d": 2.5},
  {"part": 3, "screen": "page", "shot": "chosen", "taps": ["send"], "cap": "$s_send", "d": 2.6},
  {"part": 4, "screen": "home", "taps": ["claude"], "cap": "$s_claude", "d": 2.5},
  {"part": 4, "screen": "tabs", "taps": ["code"], "cap": "$s_code", "d": 2.5},
  {"part": 4, "screen": "tabs", "code": true, "taps": ["sess"], "cap": "$s_sess", "d": 2.6},
  {"part": 4, "screen": "chat", "taps": ["go"], "tapAt": 1.3, "cap": "$s_cmd", "d": 3.4},
  {"part": 5, "screen": "page", "shot": "ready", "taps": ["gallery"], "cap": "$s_gallery", "d": 2.7},
  {"part": 5, "screen": "allow", "taps": ["always"], "cap": "$s_allow", "d": 2.8},
  {"part": 5, "screen": "photos", "ring": "newv", "cap": "$s_photos", "d": 2.6}
 ],
 "end": {"d": 3.2, "title": "$end_title", "rows": "$end_rows"},
 "fade": 0.2
}
